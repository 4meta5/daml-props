-- | Property-based tests for the AL-10 account-freeze model. Demonstrates that the
-- OpenZeppelin canton-token-template freeze semantics hold for all action sequences,
-- and that dropping any one guard is detected — including the two review fixes that
-- the abstract daml-verify proofs cannot express: the owner+provider check (#3) and
-- the cold-path mint-accept re-check (#1).
module DamlProps.Examples.Freeze.Properties where

import Daml.Script
import DamlProps.Runner
import DamlProps.Examples.Freeze.Model

fzConfig : Text -> RunnerConfig
fzConfig name = (defaultRunnerConfig name) with
  numTests = 100
  maxSequenceLength = 14

-- | Asserts a (buggy-executor, invariant) pair is CAUGHT — the negative tests.
expectDetected :
  Text
  -> (FreezeState -> FreezeAction -> Either Text FreezeState)
  -> (FreezeState -> Either Text ())
  -> Script ()
expectDetected name executor inv = script do
  let result = runProp (fzConfig name) genFreezeAction executor inv mkInitialFreezeState
  case result of
    FoundFailure d -> debug (name <> " DETECTED (minimal " <> show (length d.fdMinimalSequence) <> " steps): " <> d.fdFailure.invariantError)
    AllPassed _ _ -> error ("UNEXPECTED: " <> name <> " should have been detected")

-- | Asserts the fixed model satisfies an invariant for all sequences.
expectAllPassed :
  Text
  -> (FreezeState -> Either Text ())
  -> Script ()
expectAllPassed name inv = script do
  let result = runProp (fzConfig name) genFreezeAction executeFreezeFixed inv mkInitialFreezeState
  case result of
    AllPassed _ n -> debug (name <> ": PASSED (" <> show n <> " tests)")
    FoundFailure d -> error (formatDetail d)

-- | Property A: the fixed model satisfies every freeze invariant. NON-VACUOUS: the
-- fixed executor records a bypass whenever its explicit gate would PROCEED despite a
-- frozen participant, so deleting the origination gate, the accept re-check, the
-- admin carve-out, or the redundancy guard makes this fail.
test_freezeInvariantsFixed : Script ()
test_freezeInvariantsFixed = expectAllPassed "freeze-invariants-fixed" checkFreezeInvariants

-- | Property B (#3): the owner+provider gate. The owner-only executor checks only the
-- account owner, so a frozen PROVIDER of a provider-managed account slips through.
test_freezeOwnerOnlyDetected : Script ()
test_freezeOwnerOnlyDetected =
  expectDetected "freeze-owner-only" executeFreezeOwnerOnly invNoFrozenOrigination

-- | Property C (#1): the cold-path accept re-check. The no-recheck executor accepts a
-- MintProposal without re-checking the freeze, so a recipient frozen in the
-- propose→accept window still receives.
test_freezeMintAcceptDetected : Script ()
test_freezeMintAcceptDetected =
  expectDetected "freeze-mint-accept" executeFreezeNoAcceptRecheck invNoMintToFrozen

-- | Property D: the admin carve-out. The admin-freezable executor lets the registry
-- administrator be set frozen.
test_freezeAdminFreezeDetected : Script ()
test_freezeAdminFreezeDetected =
  expectDetected "freeze-admin-freeze" executeFreezeAdminFreezable invAdminNeverFrozen

-- | Property E: the non-idempotency guard. The redundant executor applies no-op
-- freeze changes.
test_freezeRedundantChangeDetected : Script ()
test_freezeRedundantChangeDetected =
  expectDetected "freeze-redundant-change" executeFreezeRedundant invNoRedundantChange
